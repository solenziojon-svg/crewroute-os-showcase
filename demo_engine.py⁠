#!/usr/bin/env python3
"""
demo_engine.py (v1.0 - OFFLINE PORTFOLIO DEMO)
─────────────────────────────────────────────────────
A complete, self-contained offline console engine demonstrating 
the multi-agent debate trigger boundaries and database pipelines.
Requires zero external dependencies.
"""

import sys
import os
import json
import time
from datetime import date, datetime

# Simple ANSI terminal coloring utilities
GREEN = '\033[1;32m'
YELLOW = '\033[1;33m'
RED = '\033[1;31m'
BLUE = '\033[1;34m'
CYAN = '\033[1;36m'
BOLD = '\033[1m'
NC = '\033[0m'

class SimulatedEngine:
    def __init__(self):
        self.run_date = date.today().isoformat()
        
    def log(self, text: str, level: str = "INFO"):
        now = datetime.now().strftime("%H:%M:%S")
        if level == "OK":
            color = GREEN
        elif level == "WARN":
            color = YELLOW
        elif level == "ERROR":
            color = RED
        elif level == "SYS":
            color = BLUE
        else:
            color = NC
        print(f"{color}{now} [{level}] {text}{NC}")

    def run_pipeline(self, total_jobs: int, urgent_jobs: int):
        print(f"\n{BOLD}{CYAN}============ CREWROUTE OS RUN SIMULATION ============{NC}")
        self.log("Initializing offline database managers...", "SYS")
        time.sleep(0.5)
        
        # 1. Simulate SQLite Initializer (CJS Operational Hub)
        self.log("Simulating cjs_operating_hub SQLite initialization...", "INFO")
        time.sleep(0.4)
        self.log("SQL Schema successfully executed: dead_letter_queue [OK], governance_verdicts [OK]", "OK")
        
        # 2. Ingesting jobs
        self.log(f"Simulating sheet load. Total Jobs: {total_jobs}, At-Risk: {urgent_jobs}", "INFO")
        time.sleep(0.4)
        
        ratio = (urgent_jobs / total_jobs) if total_jobs > 0 else 0
        self.log(f"Calculated Pipeline Urgency Margin: {ratio*100:.1f}%", "SYS")
        time.sleep(0.3)
        
        # 3. Evaluating Logic Gate Trigger
        if ratio >= 0.40:
            self.log("Urgency Margin is >= 40%: Multi-Model Debate sequence engaged.", "WARN")
            time.sleep(0.5)
            
            # Simulated parallel completion loops
            self.log("Invoking parallel models: Claude 3.5 [OK], Grok-2 [OK], Gemini 1.5 [OK]", "INFO")
            time.sleep(0.6)
            self.log("Round 2 Cross-Pollination review critiques written.", "OK")
            time.sleep(0.5)
            self.log("Invoking Claude 3 Opus Synthesis model...", "SYS")
            time.sleep(0.7)
            self.log("Optimal consolidated routing matrix generated.", "OK")
            
            sim_cost = 0.0820
            sim_tokens = 12450
            track = "DEBATE_CONSENSUS"
        else:
            self.log("Urgency Margin is < 40%: Executing fast, single-model optimized track.", "INFO")
            time.sleep(0.6)
            self.log("Claude 3.5 Sonnet optimized coordinates array mapped.", "OK")
            
            sim_cost = 0.0064
            sim_tokens = 1200
            track = "SINGLE_SONNET"
            
        # 4. Telemetry Log Execution
        time.sleep(0.4)
        self.log("Logging transaction parameters straight to Postgres telemetry database...", "INFO")
        self.log(f"Telemetry Saved: Cost: ${sim_cost:.4f} | Tokens: {sim_tokens} | Model Path: {track}", "OK")
        
        # 5. Payload Shaping Gate
        time.sleep(0.3)
        self.log("Filtering payload elements via down-stream payload shaper...", "INFO")
        mock_payload = {
            "date": self.run_date,
            "crew": "Alpha",
            "ordered_jobs": [{"id": f"990{i}", "client": f"Mock Residence {i}"} for i in range(1, 3)]
        }
        self.log(f"Filtered Payload Sent: {json.dumps(mock_payload)}", "OK")
        
        # 6. Notifications Gate
        time.sleep(0.4)
        self.log("Invoking alerts.py standard library telegram dispatch...", "SYS")
        self.log("Alert Sent: telegram [OK] | discord [OK]", "OK")
        print(f"{BOLD}{CYAN}====================================================={NC}\n")


if __name__ == "__main__":
    engine = SimulatedEngine()
    
    # Run interactive parameters or default values
    print("Welcome to the CrewRoute OS Demonstration Command Center.")
    try:
        tot = int(input("Enter number of simulated total jobs (e.g., 10): ") or "10")
        urg = int(input("Enter number of simulated urgent jobs (e.g., 5): ") or "5")
    except ValueError:
        tot, urg = 10, 5
        
    engine.run_pipeline(total_jobs=tot, urgent_jobs=urg)

