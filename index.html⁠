    <!-- Simulation Engine JavaScript logic -->
    <script>
        // Init icon render
        lucide.createIcons();

        // Control DOM references
        const totalSlider = document.getElementById('totalJobs');
        const lateSlider = document.getElementById('lateJobs');
        const totalVal = document.getElementById('totalJobsVal');
        const lateVal = document.getElementById('lateJobsVal');
        const ratioText = document.getElementById('urgencyRatio');
        const ratioBar = document.getElementById('urgencyBar');
        const runBtn = document.getElementById('runBtn');
        const consoleBox = document.getElementById('consoleBox');
        const debatePanel = document.getElementById('debatePanel');
        const alertsContainer = document.getElementById('phoneAlerts');
        const emptyAlertState = document.getElementById('emptyAlertState');

        // Telemetry DOM references
        const telCost = document.getElementById('telemetryCost');
        const telTokens = document.getElementById('telemetryTokens');
        const telLatency = document.getElementById('telemetryLatency');
        const telTrack = document.getElementById('telemetryTrack');

        // Dynamic State Calculation
        function updateGauges() {
            const total = parseInt(totalSlider.value);
            let late = parseInt(lateSlider.value);

            // Constraint: Late cannot exceed total
            if (late > total) {
                late = total;
                lateSlider.value = total;
            }

            totalVal.textContent = total;
            lateVal.textContent = late;

            const ratio = total > 0 ? (late / total) * 100 : 0;
            ratioText.textContent = ratio.toFixed(1) + '%';
            ratioBar.style.width = ratio + '%';

            if (ratio >= 40) {
                ratioText.className = 'code-font font-semibold text-amber-400 animate-pulse';
                ratioBar.className = 'bg-amber-500 h-full rounded-full transition-all duration-300';
                document.getElementById('routingMethodNote').innerHTML = 'Ratio &ge; 40%: Multi-agent debate gate will engage automatically.';
            } else {
                ratioText.className = 'code-font font-semibold text-emerald-400';
                ratioBar.className = 'bg-emerald-500 h-full rounded-full transition-all duration-300';
                document.getElementById('routingMethodNote').innerHTML = 'Ratio &lt; 40%: Executing fast, single-model optimized trajectory.';
            }
        }

        totalSlider.addEventListener('input', updateGauges);
        lateSlider.addEventListener('input', updateGauges);
        updateGauges();

        // Logging Utils
        function writeLog(text, level = 'info') {
            const div = document.createElement('div');
            const now = new Date().toLocaleTimeString();
            let color = 'text-slate-300';
            let prefix = '[INFO]';

            if (level === 'success') { color = 'text-emerald-400'; prefix = '[OK]  '; }
            else if (level === 'warn') { color = 'text-amber-400'; prefix = '[WARN]'; }
            else if (level === 'error') { color = 'text-red-400'; prefix = '[FAIL]'; }
            else if (level === 'system') { color = 'text-blue-400'; prefix = '[SYS] '; }

            div.className = `${color} leading-relaxed`;
            div.innerHTML = `<span class="text-slate-600">${now}</span> <span class="font-bold">${prefix}</span> ${text}`;
            consoleBox.appendChild(div);
            consoleBox.scrollTop = consoleBox.scrollHeight;
        }

        // Simulated Processing Loop
        async function startSimulation() {
            runBtn.disabled = true;
            runBtn.className = "w-full py-3 bg-slate-850 border border-slate-800 text-slate-500 font-semibold text-sm rounded-xl cursor-not-allowed transition-all flex items-center justify-center gap-2";
            
            // Clear prior states
            consoleBox.innerHTML = '';
            debatePanel.classList.add('hidden');
            emptyAlertState.classList.remove('hidden');
            
            // Clean active alerts
            const oldAlerts = alertsContainer.querySelectorAll('.alert-card');
            oldAlerts.forEach(a => a.remove());

            writeLog("Booting CrewRoute OS Execution Pipeline...", 'system');
            await sleep(1000);

            // Step 1: Loading Databases
            writeLog("Reading sqlite_schema.sql configuration boundaries...", 'info');
            await sleep(800);
            writeLog("CJS Operating Hub: SQLite Database Schema instantiated cleanly.", 'success');
            await sleep(600);

            // Step 2: Loading Job Ledger
            const total = parseInt(totalSlider.value);
            const late = parseInt(lateSlider.value);
            writeLog(`Reading target Google Sheet jobs for crew "Alpha"...`, 'info');
            await sleep(1000);
            writeLog(`Loaded ${total} jobs. Detected ${late} priority late/risk-flagged locations.`, 'success');
            await sleep(600);

            const ratio = (late / total) * 100;
            writeLog(`Evaluating Pipeline Urgency Margin: ${ratio.toFixed(1)}%`, 'system');
            await sleep(600);

            if (ratio >= 40) {
                // Multi-Model Debate Track
                writeLog("Urgency Threshold Crossed (>= 40%). Triggering parallel debate path.", 'warn');
                debatePanel.classList.remove('hidden');
                document.getElementById('cardClaude').className = 'bg-slate-950 p-2.5 rounded-xl border border-orange-500/30 shadow-lg shadow-orange-500/5 flex flex-col gap-1 transition-all';
                document.getElementById('cardGrok').className = 'bg-slate-950 p-2.5 rounded-xl border border-purple-500/30 shadow-lg shadow-purple-500/5 flex flex-col gap-1 transition-all';
                document.getElementById('cardGemini').className = 'bg-slate-950 p-2.5 rounded-xl border border-blue-500/30 shadow-lg shadow-blue-500/5 flex flex-col gap-1 transition-all';
                
                document.getElementById('claudState').textContent = "COMPUTING MODEL...";
                document.getElementById('grokState').textContent = "COMPUTING MODEL...";
                document.getElementById('gemState').textContent = "COMPUTING MODEL...";
                await sleep(1200);

                // Round 1 Complete
                writeLog("Concurrently generated Round 1 models from Claude, Grok, and Gemini.", 'info');
                document.getElementById('claudState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R1 OK</span>";
                document.getElementById('grokState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R1 OK</span>";
                document.getElementById('gemState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R1 OK</span>";
                await sleep(800);

                // Round 2 Peer Review
                writeLog("Entering Round 2: Distributing peer outputs for multi-agent critical review.", 'system');
                document.getElementById('claudState').textContent = "CRITIQUING PEERS...";
                document.getElementById('grokState').textContent = "CRITIQUING PEERS...";
                document.getElementById('gemState').textContent = "CRITIQUING PEERS...";
                await sleep(1200);

                document.getElementById('claudState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R2 REFINED</span>";
                document.getElementById('grokState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R2 REFINED</span>";
                document.getElementById('gemState').innerHTML = "<span class='text-emerald-400 font-semibold'>MODEL R2 REFINED</span>";
                writeLog("Consensus critiques submitted.", 'success');
                await sleep(800);

                // Synthesis via Opus
                writeLog("Spawning high-reasoning Synthesis Engine (Claude-3-Opus)...", 'system');
                await sleep(1500);
                writeLog("Synthesis complete. Master optimal JSON array compiled.", 'success');

                // Update Telemetry Panel
                telCost.textContent = "$0.0820";
                telTokens.textContent = "12,450";
                telLatency.textContent = "3,452ms";
                telTrack.textContent = "DEBATE CONSENSUS";
                telTrack.className = "code-font font-bold text-sm text-purple-400";

            } else {
                // Fast Path
                writeLog("Route margin healthy (< 40%). Routing to single-model optimizer.", 'info');
                await sleep(1200);
                writeLog("Claude-3-5-Sonnet optimized trajectory generated.", 'success');

                // Update Telemetry Panel
                telCost.textContent = "$0.0064";
                telTokens.textContent = "1,200";
                telLatency.textContent = "1,120ms";
                telTrack.textContent = "SINGLE SONNET";
                telTrack.className = "code-font font-bold text-sm text-emerald-400";
            }

            // Database commits & formatting
            await sleep(600);
            writeLog("Writing optimized results table back to sheets RESULTS_TAB...", 'info');
            await sleep(800);
            writeLog("Shaping telemetry log arrays using downstream _shape_for_make filter...", 'info');
            await sleep(600);
            writeLog("Dispatched payload schema safely to Make.com Webhook Gateway.", 'success');

            // Dispatch Phone Notifications
            await sleep(600);
            writeLog("Dispatching adaptive alert notifications to mobile...", 'system');
            await sleep(1000);

            triggerMobileNotification(ratio >= 40, total, late);
            writeLog("Pipeline run completed cleanly. Sandbox IDLE.", 'success');

            // Reset button
            runBtn.disabled = false;
            runBtn.className = "w-full py-3 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-semibold text-sm rounded-xl shadow-lg shadow-emerald-500/10 hover:shadow-emerald-500/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2";
        }

        // Inject simulated alert into phone wireframe
        function triggerMobileNotification(isDebate, total, late) {
            emptyAlertState.classList.add('hidden');

            const card = document.createElement('div');
            card.className = "alert-card bg-slate-900 border border-slate-800 p-3.5 rounded-2xl shadow-xl transition-all duration-500 transform translate-y-2 opacity-0 flex flex-col gap-2";

            const emoji = isDebate ? "🚨" : "✅";
            const headerColor = isDebate ? "text-amber-400" : "text-emerald-400";
            const statusLabel = isDebate ? "YELLOW (DEBATE RUN)" : "GREEN (STABLE)";

            card.innerHTML = `
                <div class="flex items-center gap-1.5 border-b border-slate-800/80 pb-1.5">
                    <span class="text-sm">${emoji}</span>
                    <span class="text-[10px] font-bold tracking-tight text-white">CREWROUTE OS DAILY</span>
                </div>
                <div class="text-[11px] leading-relaxed text-slate-300 flex flex-col gap-1">
                    <div>📅 Date: ${new Date().toISOString().split('T')[0]}</div>
                    <div>👷 Crew: Alpha</div>
                    <div>📦 Jobs Configured: ${total}</div>
                    <div>⚠️ Urgent Flags: ${late}</div>
                    <div class="mt-1 font-semibold text-slate-200">⏱️ Time Saved: ${isDebate ? "82 mins" : "45 mins"}</div>
                    <div class="font-semibold text-slate-200">💰 Total Value: $${isDebate ? "4,850" : "1,200"}</div>
                </div>
                <div class="text-[9px] code-font ${headerColor} mt-1 pt-1.5 border-t border-slate-800/80 flex items-center gap-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                    <span>STATUS: ${statusLabel}</span>
                </div>
            `;

            alertsContainer.appendChild(card);
            
            // Trigger entry transition
            setTimeout(() => {
                card.classList.remove('translate-y-2', 'opacity-0');
            }, 10);
        }

        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
    </script>
</body>
</html>

